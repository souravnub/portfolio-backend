generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  password String
  name     String @unique
}

model Project {
  id                Int              @id @default(autoincrement())
  name              String
  role              String
  image             String?
  yearOfProduction  String
  techUsed          String[]
  description       String
  quote             String?
  brandColor        String
  brandImageUrl     String?
  brandNameImageUrl String?
  videoUrl          String?
  mobileImageUrl1   String?
  mobileImageUrl2   String?
  mobileVideoUrl    String?
  productionLink    String?
  githubLink        String?
  isPublished       Boolean          @default(false)
  tabletImageUrl    String?
  tabletVideoUrl    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  contributors      Contribution[]
  skillsEnhanced    SkillsEnhanced[]
}

model SkillsEnhanced {
  id          Int     @id @default(autoincrement())
  projectId   Int
  name        String
  description String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model HomePageContent {
  id                    Int    @id @default(autoincrement())
  mainImageUrl          String
  country               String
  role                  String
  portfolio_slogan      String
  portfolio_description String
}

model message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  replied   Boolean  @default(false)
  isDeleted Boolean  @default(false)
}

model Contributor {
  id            Int            @id @default(autoincrement())
  profileImage  String?
  socialUrl     String
  firstName     String
  lastName      String
  contributions Contribution[]
}

model Contribution {
  id            Int         @id @default(autoincrement())
  projectId     Int
  contributorId Int
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Todo {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(255)
  description String? @db.VarChar(255)
  done        Boolean @default(false)
  owner       Int
  User        User    @relation(fields: [owner], references: [id])
}

model User {
  id         Int    @id @default(autoincrement())
  name       String
  email      String @unique
  password   String
  profileImg String @default("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTet-jk67T6SYdHW04eIMLygHzEeJKobi9zdg&s")
  Todo       Todo[]
}
